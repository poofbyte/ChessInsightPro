{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./.next",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@chessinsight/*": ["../../packages/analysis/*/src", "../../packages/core/*/src", "../../packages/player/*/src", "../../packages/shared/*/src", "../../packages/training/*/src", "../../packages/visualization/*/src"],
      "@core/*": ["../../packages/core/*/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
