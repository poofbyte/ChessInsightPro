# Turso Database Credentials (libSQL)
# Get these by creating a database at https://turso.tech
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Authentication
# Generate two separate secure random strings for JWT signing
# Example (node): require('crypto').randomBytes(32).toString('hex')
JWT_ACCESS_SECRET="your-access-token-secret"
JWT_REFRESH_SECRET="your-refresh-token-secret"

# Vercel Cron Job Secret
# Used to authenticate the automated puzzle generation endpoint
CRON_SECRET="your-cron-secret-key"

# Hugging Face Inference API (Optional)
# Used for the Play Coach narrative tips. If left blank, it uses a generic fallback.
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# Password Reset Secret (optional — falls back to JWT_ACCESS_SECRET if not set)
# Generate a separate random string for signing password-reset tokens
JWT_PASSWORD_RESET_SECRET=""

# Admin Bootstrap (optional — creates initial admin account on first run)
# Only used when no admin user exists yet
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="your-secure-admin-password"

# SMTP Configuration (Gmail App Password)
# Used as fallback for sending password-reset and notification emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Email Configuration (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="melivronstudio@gmail.com"
ADMIN_NOTIFICATION_EMAIL="hiranmayroy183@gmail.com"
